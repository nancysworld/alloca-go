{
  "uid": "alloca-frontier",
  "title": "Alloca-Go \u2014 single-instance frontier",
  "description": "AG-Sept diagnostic view. Generated by test/scripts/gen-dashboard.py from deploy/observability/panels.json \u2014 edit that file and re-run, never this one. Deliberately one dashboard with the scoped panels only (measurement-contract \u00a76 excludes rich dashboards, alerting and plugins). This is the view you watch while a sweep runs; the report quotes the CSVs the exporter writes, not this.",
  "tags": [
    "ag-sept",
    "generated"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Demand and outcome",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput and goodput",
      "datasource": {
        "type": "prometheus",
        "uid": "alloca-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alloca-prometheus"
          },
          "expr": "sum(rate(alloca_requests_total[$__rate_interval]))",
          "legendFormat": "Completed throughput",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "alloca-prometheus"
          },
          "expr": "sum(rate(alloca_requests_total{operation=~\"reserve|confirm|cancel\",outcome=\"admitted_success\",replay=\"false\"}[$__rate_interval]))",
          "legendFormat": "Successful mutation goodput",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "alloca-prometheus"
          },
          "expr": "sum(rate(alloca_requests_total{operation=~\"reserve|confirm|cancel\",outcome=\"admitted_success\",replay=\"true\"}[$__rate_interval]))",
          "legendFormat": "Replayed mutations",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "alloca-prometheus"
