      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alloca-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(alloca_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "Request latency p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "alloca-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(alloca_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "Request latency p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "alloca-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(alloca_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "Request latency p99",
          "range": true
        }
      ]
    },
